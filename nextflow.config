// nextflow.config


// Define global variables (Parameters)
params {
    input_dir = "data/reads"
    ref_seed  = "data/ref/seed.fasta"
    ref_gb    = "data/ref/reference.gb"
    out_dir   = "results"
    
    // Default hardware (Laptop safe)
    cpus         = 2
    memory       = '4 GB'
    fastp_cpus   = 2
    fastp_memory = '4 GB'
}


// Profiles
profiles {

    // Profile 1: For the standard user on a laptop/desktop
    standard {
        docker.enabled         = true
        singularity.enabled    = false
        process.executor       = 'local'
        
        // Laptop hardware limits
        params.cpus         = 2
        params.memory       = '4 GB'
        params.fastp_cpus   = 2
        params.fastp_memory = '4 GB'
    }

    // Profile 2: For university HPC users
    hpc {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        process.executor       = 'slurm'
        
        // Supercomputer hardware limits
        params.cpus         = 16
        params.memory       = '64 GB'
        params.fastp_cpus   = 8
        params.fastp_memory = '32 GB'
    }

    // Profile 3: For users on AWS Cloud
    aws {
        docker.enabled         = true
        process.executor       = 'awsbatch'
        aws.region             = 'us-east-1'
        aws.batch.cliPath      = '/home/ec2-user/miniconda/bin/aws'
        // AWS users will typically provide their own queue via command line
        // e.g., --queue 'my-aws-queue'
    }
}

// Global Process Block
process {
    cpus   = params.cpus
    memory = params.memory
    
    withName: FASTP {
        cpus   = params.fastp_cpus
        memory = params.fastp_memory
    }
}